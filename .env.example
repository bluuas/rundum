# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Development and every test run against the local Docker stack: start it with
# `npm run db:start` and paste the three values it prints. The hosted demo
# project lives in a separate .env.demo, used only by `npm run db:seed:demo`.
#
# Project URL and anon key are safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key bypasses RLS. Server-side only — never import it into a
# Client Component and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-in links ----------------------------------------------------------
# Where an emailed sign-in link comes back to. Optional: left empty, the app
# uses the host the request arrived on, which is what makes localhost and
# preview deployments work without configuration. Set it on a real deployment,
# where there is one correct answer and the host header is somebody else's
# input.
#
# Whatever it is must also be in the Supabase project's redirect allow-list
# (Authentication -> URL Configuration; `additional_redirect_urls` in
# supabase/config.toml for local), or Supabase refuses to redirect there.
NEXT_PUBLIC_SITE_URL=

# --- Development auth -------------------------------------------------------
# Enables the mock login route and the dev user switcher. Has no effect when
# NODE_ENV=production; the route refuses to load there regardless.
ALLOW_MOCK_AUTH=true

# --- Public demo ------------------------------------------------------------
# Turns on account switching for a DEPLOYED build, so anyone with the link can
# sign in as any seeded demo account. Unlike ALLOW_MOCK_AUTH this does work in
# production — that is the whole point of it, and why it has its own name.
#
# It also puts a shared-accounts warning in the header and disallows crawlers.
# Only seeded @demo.rundum.app accounts can ever be signed in as, in any mode,
# so an account belonging to a real person is unreachable either way.
#
# Never set this on a deployment with real users.
DEMO_MODE=

# --- Strava OAuth -----------------------------------------------------------
# Server-side only. Tokens obtained with these never reach the browser.
#
# Creating a Strava application requires a Strava subscription, and every new
# application starts in "single-player mode" where only its owner can sign in.
# Until you have credentials, run the local stand-in instead:
#
#   npm run dev:strava
#   STRAVA_AUTH_BASE_URL=http://localhost:4400
#   STRAVA_CLIENT_ID=fake-client-id
#   STRAVA_CLIENT_SECRET=fake-client-secret
#
# Leaving all three of the values below blank simply hides the Strava button.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback

# Where the OAuth endpoints live. Unset means real Strava; set it to point the
# whole flow at the local stand-in above. Only the hostname changes — the code
# path is identical.
STRAVA_AUTH_BASE_URL=

# Strava's read scope returns no email address, so accounts created through
# Strava get a synthetic one at this domain. It is never displayed and never
# receives mail; use a domain you control, or one that cannot resolve.
STRAVA_ACCOUNT_EMAIL_DOMAIN=strava.rundum.invalid

# --- Reaching the dev server from another device -----------------------------
# Next blocks cross-origin requests to dev-only endpoints, so opening the app
# from a phone on the same wifi needs that device's network listed here.
# Comma-separated hostnames, no scheme and no port; `*` matches one label.
# Find your address with: ip -4 addr show scope global
#
#   DEV_ALLOWED_ORIGINS=192.168.31.*
#
# Leave it unset and only localhost may reach the dev server. Development only —
# it has no effect on a production build.
DEV_ALLOWED_ORIGINS=
