# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key bypasses RLS. Server-side only — never import it into a
# Client Component and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Development auth -------------------------------------------------------
# Enables the mock login route and the dev user switcher. Has no effect when
# NODE_ENV=production; the route refuses to load there regardless.
ALLOW_MOCK_AUTH=true

# --- Strava OAuth -----------------------------------------------------------
# Server-side only. Tokens obtained with these never reach the browser.
#
# Creating a Strava application requires a Strava subscription, and every new
# application starts in "single-player mode" where only its owner can sign in.
# Until you have credentials, run the local stand-in instead:
#
#   npm run dev:strava
#   STRAVA_AUTH_BASE_URL=http://localhost:4400
#   STRAVA_CLIENT_ID=fake-client-id
#   STRAVA_CLIENT_SECRET=fake-client-secret
#
# Leaving all three of the values below blank simply hides the Strava button.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback

# Where the OAuth endpoints live. Unset means real Strava; set it to point the
# whole flow at the local stand-in above. Only the hostname changes — the code
# path is identical.
STRAVA_AUTH_BASE_URL=

# Strava's read scope returns no email address, so accounts created through
# Strava get a synthetic one at this domain. It is never displayed and never
# receives mail; use a domain you control, or one that cannot resolve.
STRAVA_ACCOUNT_EMAIL_DOMAIN=strava.rundum.invalid

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
